# Controle MP — produção (exemplo para docker-compose.prod.yml)
# Copie para .env.production e preencha segredos.

DELPI_NOTIFICATIONS_ENABLED=true
DELPI_CORE_API_URL=https://minhadelpi.com.br/core-api
CORE_API_INTEGRATIONS_SERVICE_TOKEN=igual_ao_delpi_central_infra_env_prod
DELPI_PORTAL_CONTROLE_MP_ROUTE=/apps/controle-mp

ENVIRONMENT=production
DEBUG=false
LOCAL_ADMIN_SEED_ENABLED=false
