# ========================================================
# Controle MP — PRODUÇÃO (exemplo)
# Copie para .env.production no servidor. NÃO versionar.
# ========================================================

# --------------------------------------------------------
# Integração notificações ↔ Minha DELPI (OBRIGATÓRIO alinhar)
# --------------------------------------------------------
DELPI_NOTIFICATIONS_ENABLED=true
DELPI_CORE_API_INTERNAL_URL=http://host.docker.internal/core-api
DELPI_CORE_API_URL=https://minhadelpi.com.br/core-api

# DEVE ser IDÊNTICO ao CORE_API_INTEGRATIONS_SERVICE_TOKEN
# em delpi-central/infra/.env (ou .env.prod) da Core API
CORE_API_INTEGRATIONS_SERVICE_TOKEN=COPIE_DO_delpi-central_infra_env

# basePath do app no portal (Admin → Apps). Ex.: URL minhadelpi.com.br/controle-mp
DELPI_PORTAL_CONTROLE_MP_ROUTE=/controle-mp

# --------------------------------------------------------
# JWT local Controle MP (NÃO é o token de integração acima!)
# --------------------------------------------------------
JWT_SECRET=chave_longa_somente_para_jwt_do_controle_mp
JWT_ISSUER=cadastro-mp-api
JWT_AUDIENCE=cadastro-mp-front

# --------------------------------------------------------
# SSO Minha DELPI (iframe + login central)
# --------------------------------------------------------
# srv-api (Docker): host.docker.internal | alternativa: URL HTTPS pública
CENTRAL_JWKS_URL=http://host.docker.internal/auth/realms/delpi/protocol/openid-connect/certs
CENTRAL_JWT_ISSUER=https://minhadelpi.com.br/auth/realms/delpi
CENTRAL_JWT_AUDIENCE=delpi-central
CENTRAL_JWT_VERIFY_AUDIENCE=true
CENTRAL_DEFAULT_ROLE_ID=3

# --------------------------------------------------------
# CORS — domínio do MP + portal pai (iframe)
# --------------------------------------------------------
CORS_ORIGINS=https://controle-mp.minhadelpi.com.br,https://minhadelpi.com.br

# --------------------------------------------------------
# Frontend build (docker-compose.prod.yml)
# --------------------------------------------------------
VITE_PROD_API_BASE_URL=
VITE_PROD_API_PREFIX=/api
VITE_PROD_SOCKET_PATH=/socket.io
VITE_PROD_DELPI_PARENT_ORIGIN=https://minhadelpi.com.br

ENVIRONMENT=production
DEBUG=false
LOCAL_ADMIN_SEED_ENABLED=false
