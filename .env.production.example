# Controle MP — produção (exemplo para docker-compose.prod.yml)
# Copie para .env.production e preencha segredos.

# NÃO troque JWT_SECRET após go-live sem forçar novo login de todos os usuários.
JWT_SECRET=use_uma_chave_longa_e_estavel
JWT_ISSUER=cadastro-mp-api
JWT_AUDIENCE=cadastro-mp-front

CENTRAL_JWKS_URL=https://minhadelpi.com.br/auth/realms/delpi/protocol/openid-connect/certs
CENTRAL_JWT_ISSUER=https://minhadelpi.com.br/auth/realms/delpi
CENTRAL_JWT_AUDIENCE=delpi-central

DELPI_NOTIFICATIONS_ENABLED=true
DELPI_CORE_API_URL=https://minhadelpi.com.br/core-api
CORE_API_INTEGRATIONS_SERVICE_TOKEN=igual_ao_delpi_central_infra_env_prod
DELPI_PORTAL_CONTROLE_MP_ROUTE=/apps/controle-mp

ENVIRONMENT=production
DEBUG=false
LOCAL_ADMIN_SEED_ENABLED=false

VITE_PROD_API_BASE_URL=
VITE_PROD_API_PREFIX=/api
VITE_PROD_SOCKET_PATH=/socket.io
VITE_PROD_DELPI_PARENT_ORIGIN=https://minhadelpi.com.br
