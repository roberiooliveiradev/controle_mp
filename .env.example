# =============================================================================
# Controle MP — variáveis de ambiente (exemplo)
# Copie para .env e ajuste os valores. Nunca commite .env com segredos reais.
# =============================================================================

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=controle-mp

POSTGRES_IMAGE=postgres:15
POSTGRES_HOST_PORT=5433

API_BUILD_CONTEXT=./api-cadastro-mp
API_DOCKERFILE=Dockerfile
API_HOST_PORT=5000
API_CONTAINER_PORT=5000
API_UPLOADS_HOST_PATH=./api-cadastro-mp/uploads

FRONT_BUILD_CONTEXT=./front-cadastro-mp
FRONT_DOCKERFILE=Dockerfile
FRONT_HOST_PORT=8088

DOCKER_NETWORK_DRIVER=bridge
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# --- API (Gunicorn / Flask) ---
GUNICORN_WORKERS=1
GUNICORN_WORKER_CONNECTIONS=1000

APP_PREFIX=
ENVIRONMENT=development
DEBUG=true

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (aplicação) ---
POSTGRES_DB=controle_mp_db
POSTGRES_USER=controle_mp
POSTGRES_PASSWORD=altere_esta_senha

DB_ENGINE=postgresql
DB_HOST=controle-mp-db
DB_PORT=5432
DB_NAME=controle_mp_db
DB_USER=controle_mp
DB_PASSWORD=altere_esta_senha
DB_SSL=false

# Aliases aceitos pelo script de migrations
DATABASE_HOST=controle-mp-db
DATABASE_PORT=5432
DATABASE_NAME=controle_mp_db
DATABASE_USER=controle_mp
DATABASE_PASSWORD=altere_esta_senha

# --- JWT (auth local) ---
JWT_SECRET=altere_para_uma_chave_longa_e_aleatoria
JWT_ISSUER=cadastro-mp-api
JWT_AUDIENCE=cadastro-mp-front
JWT_ACCESS_MINUTES=60
JWT_REFRESH_MINUTES=10080

# --- SSO Minha DELPI / Keycloak (opcional) ---
CENTRAL_JWKS_URL=https://seu-dominio/auth/realms/delpi/protocol/openid-connect/certs
CENTRAL_JWT_ISSUER=https://seu-dominio/auth/realms/delpi
CENTRAL_JWT_AUDIENCE=delpi-central
CENTRAL_DEFAULT_ROLE_ID=3

# --- Arquivos ---
FILES_STORAGE_TYPE=local
FILES_BASE_PATH=/app/uploads
FILES_PUBLIC_BASE_URL=/files
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=

# --- TOTVS / SQL Server (opcional — API sobe sem estas variáveis) ---
TOTVS_DB_HOST=
TOTVS_DB_PORT=1433
TOTVS_DB_NAME=
TOTVS_DB_USER=
TOTVS_DB_PASSWORD=

# --- Migrations e admin local ---
RUN_DATABASE_MIGRATIONS_ON_STARTUP=true
ALLOW_DATABASE_RESET=false
DB_CONNECT_TIMEOUT=10
DB_SSLMODE=prefer

LOCAL_ADMIN_SEED_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@local.com
LOCAL_ADMIN_PASSWORD=altere_senha_admin
LOCAL_ADMIN_FULL_NAME=Administrador Local
LOCAL_ADMIN_ROLE_ID=1

# --- Integração notificações Minha DELPI ---
# Use o mesmo CORE_API_INTEGRATIONS_SERVICE_TOKEN configurado na Core API (delpi-central/infra/.env)
DELPI_NOTIFICATIONS_ENABLED=true
# Tamanho do lote por requisição à Core API (padrão 100)
# DELPI_NOTIFICATIONS_BATCH_SIZE=100
DELPI_CORE_API_INTERNAL_URL=http://host.docker.internal/core-api
DELPI_CORE_API_URL=https://minhadelpi.com.br/core-api
# Docker local com stack DELPI no host: http://host.docker.internal/core-api
CORE_API_INTEGRATIONS_SERVICE_TOKEN=altere_igual_ao_delpi_central
# Rota do app no portal Minha DELPI (ver Admin → Apps → basePath)
DELPI_PORTAL_CONTROLE_MP_ROUTE=/controle-mp

# --- Frontend (build Vite / Docker) ---
# Em Docker local, deixe VITE_API_BASE_URL vazio para usar proxy nginx na mesma origem
VITE_API_BASE_URL=
VITE_API_PREFIX=/api
VITE_SOCKET_PATH=/socket.io
VITE_DELPI_PARENT_ORIGIN=http://localhost:5173

# Produção (docker-compose.prod.yml)
VITE_PROD_API_BASE_URL=
VITE_PROD_API_PREFIX=/api
VITE_PROD_SOCKET_PATH=/socket.io
VITE_PROD_DELPI_PARENT_ORIGIN=https://minhadelpi.com.br
